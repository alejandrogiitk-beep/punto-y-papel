# Copia este archivo con el nombre .env y escribe tus valores.
# El archivo .env NO se sube a GitHub (esta en .gitignore).

# Clave para firmar las sesiones de Flask. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=escribe_aqui_una_clave_larga_y_secreta

# Conexion a MongoDB
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/
MONGO_URI=mongodb://localhost:27017/
